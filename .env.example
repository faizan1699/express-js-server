PORT=3000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/express_auth

# Use long, random values. JWT_SECRET can be omitted when JWT_ACCESS_SECRET is set.
JWT_ACCESS_SECRET=replace-with-a-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-refresh-secret

# Gmail SMTP credentials are needed to deliver signup and password-reset OTPs.
GMAIL_USER=your-email@gmail.com
GMAIL_PASS=your-16-character-gmail-app-password
SMTP_USER=your-email@gmail.com
